# Game media and anything derived from it never enters the repo
*.iso
*.ISO
*.bin
*.cue
work/
research/

# Build outputs and dependencies
node_modules/
build/
dist/
.venv/
*.o
*.a
*.wasm
__pycache__/
.DS_Store

# Staged build output (regenerated by tools/build-web.sh)
web/public/engine/

# Android: Gradle/NDK outputs, the AOT image (built from the user's own executable) and the side table.
android/local.properties
# Release signing: the key that lets an APK update an installed copy. Losing it forces every player to
# reinstall; leaking it lets anyone publish updates. Neither belongs in the repository.
*.jks
*.keystore
android/keystore.properties
# The exception: the *debug* key is committed on purpose. It is public by definition (password
# "android"), and it is what makes every build of this app the same app, so an installed copy can be
# updated instead of uninstalled. See android/README.md, "Updating in place".
!android/debug.keystore
android/.gradle/
android/app/.cxx/
android/app/build/
android/app/src/main/assets/*.sk2a
android/app/src/main/assets/*.skx

# Disc-installer corpus output (generated by runtime/test/cab-lzx-corpus.mjs / tools/installer-test.sh)
runtime/test/fixtures/
